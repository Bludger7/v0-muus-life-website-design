{
  "hosting": {
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/urunler{,/**}",
        "destination": "/projeler/",
        "type": 301
      },
      {
        "source": "/ofis-calismalari{,/**}",
        "destination": "/projeler/",
        "type": 301
      },
      {
        "source": "/kurumsal-projeler{,/**}",
        "destination": "/projeler/",
        "type": 301
      }
    ]
  }
}